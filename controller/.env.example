# Optional Thymis Assistant configuration.
# The assistant needs a model that supports tool calls and image input.
#
# Default: a self-hosted OpenAI-compatible gateway (the meowl proxy).
THYMIS_AGENT_MODEL=openai:qwen3.8-27b
THYMIS_AGENT_BASE_URL=https://meowl.dev/openai/v1

# Export the gateway token in the shell that starts the controller; never
# commit API keys or write them into this file.
# export THYMIS_AGENT_API_KEY='sk-meowl-…'
#
# Alternative: call a hosted provider instead, which keeps provider-specific
# credentials in its own environment variable:
#   THYMIS_AGENT_MODEL=openrouter:openai/gpt-4.1-mini
#   export OPENROUTER_API_KEY='…'
